/* Crimson Noir палитра: глубокий темный (#02060E) и акцентный бордовый (#C50337) */

Screen {
    background: #02060E;
    color: #C50337;
    overflow-y: auto;
    align: center top;
}

#main_container {
    width: 100%;
    min-width: 40;
    max-width: 104;
    height: auto;
    background: #02060E;
    padding: 0 1;
    align-horizontal: center;
}

/* Стилизация верхнего ASCII-баннера */
HeaderBanner {
    width: 100%;
    height: auto;
    align-horizontal: center;
    margin-bottom: 1;
}

#ascii_art {
    width: 100%;
    height: auto;
    content-align: center middle;
    color: #C50337;
    text-style: bold;
}

#banner_subtitle {
    width: 100%;
    height: auto;
    content-align: center middle;
    color: #8B1E3F;
    margin-top: 1;
}

/* Стилизация терминальной рамки и сетки меню */
#menu_frame {
    width: 100%;
    height: auto;
    border: heavy #C50337;
    border-title-align: center;
    border-title-color: #C50337;
    border-title-style: bold;
    background: #02060E;
    padding: 1 1;
    margin-bottom: 1;
}

#grid_container {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.menu_column {
    width: 1fr;
    height: auto;
    padding: 0 1;
    border-right: dashed #4A0B1A;
}

.menu_column:last-child {
    border-right: none;
}

/* Адаптивный компактный режим для экранов уже 80 колонок */
.compact-layout #grid_container {
    layout: vertical;
}

.compact-layout .menu_column {
    width: 100%;
    border-right: none;
    border-bottom: dashed #4A0B1A;
    padding: 0;
}

.compact-layout .menu_column:last-child {
    border-bottom: none;
}

/* Элементы слотов меню */
MenuSlot {
    width: 100%;
    height: 1;
    color: #C50337;
    padding: 0 1;
}

MenuSlot:hover {
    background: #C50337;
    color: #02060E;
    text-style: bold;
}

MenuSlot:focus {
    background: #8B1E3F;
    color: #FFFFFF;
    text-style: bold;
}

/* Нижняя панель управления и выхода */
#footer_panel {
    width: 100%;
    height: auto;
    align-horizontal: center;
    margin-top: 1;
}

/* Горизонтальная панель функциональных кнопок с выравниванием по краям */
#action_bar {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    align-horizontal: center;
}

#action_spacer, #action_spacer_left, #action_spacer_right {
    width: 1fr;
    height: 1;
}

#action_bar Button {
    width: auto;
    min-width: 16;
    height: 3;
    border: heavy #C50337;
    background: #02060E;
    color: #C50337;
    text-style: bold;
    content-align: center middle;
    padding: 0 2;
}

#action_bar Button:hover {
    background: #C50337;
    color: #02060E;
}

#action_bar Button:focus {
    background: #8B1E3F;
    color: #FFFFFF;
    border: heavy #C50337;
}

#action_bar Button.-active {
    background: #C50337;
    color: #02060E;
}

/* Стилизация центрированной кнопки сохранения HTML */
#save_html_button {
    width: auto;
    min-width: 18;
    height: 3;
    background: #8B1E3F;
    color: #FFFFFF;
    border: heavy #C50337;
    text-style: bold;
    content-align: center middle;
    padding: 0 2;
    display: none;
}

#save_html_button:hover {
    background: #C50337;
    color: #02060E;
}

#save_html_button:focus {
    background: #C50337;
    color: #FFFFFF;
    border: heavy #FFFFFF;
}

#save_html_button.-active {
    background: #C50337;
    color: #02060E;
}

#status_message {
    width: 100%;
    height: 1;
    content-align: center middle;
    color: #8B1E3F;
    margin-bottom: 1;
}

#command_bar {
    width: 100%;
    height: 3;
    border: heavy #8B1E3F;
    background: #02060E;
    padding: 0 1;
    align-vertical: middle;
}

#command_bar:focus-within {
    border: heavy #C50337;
}

#prompt_label {
    width: auto;
    height: 1;
    color: #C50337;
    text-style: bold;
    padding: 0 1;
}

#command_input {
    width: 1fr;
    height: 1;
    background: #02060E;
    color: #D4D7DD;
    border: none;
    padding: 0;
}

#command_input:focus {
    border: none;
}
